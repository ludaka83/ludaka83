# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/studify
DB_NAME=studify

# JWT Configuration
JWT_SECRET=studify_super_secure_jwt_secret_key_for_development_32_chars_minimum
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Cloudinary Configuration (Demo/Test Values - Replace with actual credentials)
CLOUDINARY_CLOUD_NAME=studify-demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=demo_secret_replace_with_actual_secret

# Email Configuration (Demo Values - Replace with actual credentials)
EMAIL_SERVICE=gmail
EMAIL_USER=admin@studify.com
EMAIL_PASS=demo_password_replace_with_app_password

# Stripe Configuration (Demo Values - Replace with actual keys)
STRIPE_SECRET_KEY=sk_test_demo_replace_with_actual_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_demo_replace_with_actual_stripe_publishable_key

# Admin Configuration
ADMIN_EMAIL=admin@studify.com
ADMIN_PASSWORD=SecureAdmin123!

# Google AdSense (Demo Values - Replace with actual IDs)
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-demo-replace-with-actual
GOOGLE_ADSENSE_SLOT_ID=demo-slot-id

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100