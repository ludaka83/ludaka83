# Database
MONGODB_URI=mongodb://localhost:27017/studify
DB_NAME=studify

# JWT Secret
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters_development
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Cloudinary for file storage (you'll need to sign up and get these)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (for user verification)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Stripe for payment processing (you'll need to sign up and get these)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Admin Configuration
ADMIN_EMAIL=admin@studify.com
ADMIN_PASSWORD=SecureAdminPassword123!

# Google AdSense (optional)
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-your_adsense_id
GOOGLE_ADSENSE_SLOT_ID=your_ad_slot_id

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100